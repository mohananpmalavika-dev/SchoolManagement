# Oracle Cloud MediaMTX host (Public IP or domain pointing to OCI)
OCI_MEDIA_HOST=129.154.xx.xx
OCI_SRT_PORT=8890

# Krypton School ERP Tenant UUID & Publish Secret (from Oracle Cloud .env.oci)
SCHOOL_TENANT_ID=REPLACE_WITH_SCHOOL_TENANT_UUID
CCTV_PUBLISH_TOKEN=REPLACE_WITH_CCTV_PUBLISH_TOKEN

# Privacy default: strip classroom audio (true = re-encode audio to AAC)
INCLUDE_AUDIO=false

# Semicolon-separated cameraRef=rtsp_url pairs (use H.264 Sub-Stream!)
# Hikvision Ch1 Sub-Stream: rtsp://user:pass@192.168.1.64:554/Streaming/Channels/102
# Dahua/CP Plus Ch1 Sub-Stream: rtsp://user:pass@192.168.1.108:554/cam/realmonitor?channel=1&subtype=1
CAMERA_STREAMS=nursery_cam_1=rtsp://krypton_view:CHANGE_ME@192.168.1.64:554/Streaming/Channels/102
