    "@krypton/database": "workspace:*",
    "@krypton/types": "workspace:*",
    "@krypton/utils": "workspace:*",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bull": "^12.0.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
