# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://krypton:krypton@localhost:5432/krypton_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Payment Gateway Configuration (Razorpay & NPCI UPI)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
PAYMENT_GATEWAY_CALLBACK_URL="https://your-domain.com/api/v1/payments-gateway/callback"
UPI_VPA_DEFAULT="kryptonfees@icici"

# Government Compliance (UDISE+ / State Board)
UDISE_API_BASE_URL="https://api.udiseplus.gov.in/v1"
UDISE_API_KEY="your_udise_api_key_here"
UDISE_CLIENT_ID="your_udise_client_id_here"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# Logging
LOG_LEVEL=debug

# AI Teaching Tools (Free AI - No paid keys needed)
AI_TEACHER_ENABLED="true"
AI_PROVIDER="FreeAI"
GEMINI_API_KEY=""
GROQ_API_KEY=""
OLLAMA_BASE_URL=""
AI_MODEL=""

# Optional background Web Push (all three API values must be configured together).
# Generate once with: node scripts/generate-web-push-keys.mjs
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
