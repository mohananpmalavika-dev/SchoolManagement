# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://krypton:krypton@localhost:5432/krypton_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# M-Pesa Daraja API Configuration
MPESA_ENV="sandbox"
MPESA_BASE_URL="https://sandbox.safaricom.co.ke"
MPESA_CONSUMER_KEY="your_consumer_key_here"
MPESA_CONSUMER_SECRET="your_consumer_secret_here"
MPESA_SHORT_CODE="174379"
MPESA_PASSKEY="your_passkey_here"
MPESA_CALLBACK_URL="https://your-domain.com/api/v1/mpesa/stk-push/callback"
MPESA_VALIDATION_URL="https://your-domain.com/api/v1/mpesa/c2b/validation"
MPESA_CONFIRMATION_URL="https://your-domain.com/api/v1/mpesa/c2b/confirmation"

# Production URLs (change MPESA_BASE_URL when going live)
# MPESA_BASE_URL="https://api.safaricom.co.ke"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# Logging
LOG_LEVEL=debug
