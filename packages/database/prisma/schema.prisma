  status      String    @default("DRAFT")
  createdBy   String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Assignment {
  id          String                 @id @default(uuid())
  tenantId    String
  classId     String
  subjectId   String
