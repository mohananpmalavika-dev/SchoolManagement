// ===================================
// GOVERNMENT INTEGRATION (INDIA: UDISE+ / APAAR & BOARD EXAMS)
// ===================================

// UDISE+ (Unified District Information System for Education Plus) Integration
model UdiseIntegration {
  id       String @id @default(uuid())
  tenantId String

  // Configuration
  udiseSchoolCode String  @unique // 11-digit UDISE+ Code
  apiKey          String? // Encrypted
  apiSecret       String? // Encrypted
  baseUrl         String  @default("https://udiseplus.gov.in/api")

  // Status
  isEnabled  Boolean    @default(false)
  lastSyncAt DateTime?
  nextSyncAt DateTime?
  syncStatus SyncStatus @default(NEVER_SYNCED)

  // Sync Settings
  autoSync      Boolean @default(true)
  syncFrequency String  @default("DAILY") // HOURLY, DAILY, WEEKLY, MONTHLY
  syncTime      String? // HH:MM format for daily sync

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  syncLogs UdiseSyncLog[]

  @@index([tenantId])
  @@index([udiseSchoolCode])
  @@map("udise_integrations")
}

// UDISE+ Sync Logs
model UdiseSyncLog {
  id                 String @id @default(uuid())
  tenantId           String
  udiseIntegrationId String

  // Sync Details
  syncType  UdiseSyncType
  status    SyncStatus
  direction SyncDirection @default(OUTBOUND)

  // Metrics
  recordsAttempted Int @default(0)
  recordsSucceeded Int @default(0)
  recordsFailed    Int @default(0)

  // Results
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int? // In seconds

  // Error Details
  errorMessage String? @db.Text
  errorDetails Json?

  // Data
  requestPayload  Json?
  responsePayload Json?

  createdAt DateTime @default(now())

  udiseIntegration UdiseIntegration @relation(fields: [udiseIntegrationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([udiseIntegrationId])
  @@index([syncType])
  @@index([status])
  @@index([startedAt])
  @@map("udise_sync_logs")
}

enum UdiseSyncType {
  STUDENT_ENROLLMENT
  TEACHER_DATA
  SCHOOL_PROFILE
  ATTENDANCE_DATA
  EXAMINATION_RESULTS
  INFRASTRUCTURE_DATA
  APAAR_VERIFICATION
  FULL_SYNC
}

enum SyncStatus {
  NEVER_SYNCED
  PENDING
  IN_PROGRESS
  COMPLETED
  PARTIAL_SUCCESS
  FAILED
  CANCELLED
}

enum SyncDirection {
  INBOUND // From UDISE+ / APAAR to School
  OUTBOUND // From School to UDISE+ / SDMIS
  BIDIRECTIONAL
}

// UDISE+ / APAAR Student Records - Track student data synced with UDISE+ SDMIS & APAAR
model UdiseStudentRecord {
  id        String @id @default(uuid())
  tenantId  String
  studentId String @unique

  // Indian Government Identifiers
  apaarId        String? @unique // 12-digit APAAR (Automated Permanent Academic Account Registry) ID
  penNumber      String? @unique // Permanent Education Number (UDISE+ SDMIS)
  udiseStudentId String? @unique

  // Sync Status
  syncStatus   SyncStatus @default(NEVER_SYNCED)
  lastSyncedAt DateTime?

  // Validation
  validationStatus ValidationStatus @default(PENDING)
  validationErrors Json?

  // Data Snapshot (last synced data)
  lastSyncedData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@index([apaarId])
  @@index([penNumber])
  @@index([syncStatus])
  @@map("udise_student_records")
}

