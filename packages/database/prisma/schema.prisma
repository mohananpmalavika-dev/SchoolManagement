  tenantId  String
  tripId    String
  studentId String
  kind      String
  createdAt DateTime @default(now())
  trip TransportJourney @relation(fields: [tripId, tenantId], references: [id, tenantId], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@unique([tenantId, tripId, studentId, kind])
  @@index([tenantId, studentId, createdAt])
  @@map("transport_alerts")
}
