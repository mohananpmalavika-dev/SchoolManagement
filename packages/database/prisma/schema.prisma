// Krypton School ERP - Database Schema
// Multi-tenant school management system

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================================
// PLATFORM & TENANT MANAGEMENT
// ===================================

model Tenant {
  id             String       @id @default(uuid())
  name           String
  subdomain      String       @unique
  customDomain   String?      @unique
  status         TenantStatus @default(ACTIVE)
  logo           String?
  primaryColor   String       @default("#4F46E5")
  secondaryColor String       @default("#10B981")
  contactEmail   String
  contactPhone   String
  address        String?
  website        String?
  timezone       String       @default("Asia/Kolkata")
  locale         String       @default("en-IN")
  currency       String       @default("INR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subscription               Subscription?
  users                      User[]
  schools                    School[]
  students                   Student[]
  guardians                  Guardian[]
  staff                      Staff[]
  academicYears              AcademicYear[]
  feeStructures              FeeStructure[]
  invoices                   Invoice[]
  payments                   Payment[]
  paymentGatewayTransactions PaymentGatewayTransaction[]
  attendanceRecords AttendanceRecord[]
  examinations      Examination[]
  timetableEntries  TimetableEntry[]
  schoolEvents      SchoolEvent[]
  communications    Communication[]
  messageTemplates  MessageTemplate[]
  chatChannels      ChatChannel[]
  auditLogs         AuditLog[]

  @@index([subdomain])
  @@index([status])
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  EXPIRED
  CANCELLED
}

model Subscription {
  id              String             @id @default(uuid())
  tenantId        String             @unique
  planId          String
  status          SubscriptionStatus @default(TRIAL)
  startDate       DateTime
  endDate         DateTime
  trialEndsAt     DateTime?
  autoRenew       Boolean            @default(true)
  paymentMethod   String?
  lastPaymentDate DateTime?
  nextPaymentDate DateTime?

  // Usage tracking
  studentCount  Int @default(0)
  staffCount    Int @default(0)
  storageUsedMB Int @default(0)
  smsCredits    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Plan {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  description  String?
  price        Int // In INR minor units (paise)
  billingCycle BillingCycle @default(ANNUAL)
  trialDays    Int          @default(14)

  // Limits
  maxStudents  Int @default(200)
  maxStaff     Int @default(50)
  maxStorageMB Int @default(5000)
  smsCredits   Int @default(500)

  // Feature flags
  features Json // Store as JSON array

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([slug])
  @@index([isActive])
  @@map("plans")
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

// ===================================
// SCHOOL CONFIGURATION
// ===================================

model School {
  id                 String  @id @default(uuid())
  tenantId           String
  name               String
  shortName          String?
  motto              String?
  vision             String?
  mission            String?
  registrationNumber String?

  // Contact
  email          String
  phone          String
  alternatePhone String?
  address        String
  city           String
  district       String?
  state          String  @default("Kerala")
  pincode        String?
  country        String  @default("India")

  // Indian Board & Academic Configuration
  schoolType        SchoolType
  programme         SchoolProgramme @default(STANDARD)
  boardAffiliation  String           @default("CBSE") // CBSE, ICSE, STATE_BOARD, IB, IGCSE
  udiseCode         String?
  affiliationNumber String?
  educationLevel    EducationLevel[]
  academicCalendar  AcademicCalendar @default(TWO_TERM)
  startMonth        Int              @default(4) // April

  // Razorpay / UPI Payment Gateway Configuration (encrypted secrets)
  razorpayEnabled       Boolean @default(false)
  razorpayKeyId         String?
  razorpayKeySecret     String? // Encrypted
  razorpayWebhookSecret String? // Encrypted
  upiVpa                String? // School merchant UPI ID (e.g. school@okhdfcbank)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes Class[]
  streams Stream[]

  @@index([tenantId])
  @@map("schools")
}

enum SchoolType {
  PUBLIC
  PRIVATE
  ACADEMY
  TUITION_CENTRE
  INTERNATIONAL
}

enum SchoolProgramme {
  STANDARD
  PRESCHOOL
  COMBINED
}

enum PreschoolStage {
  PLAYGROUP
  NURSERY
  LKG
  UKG
}

enum EducationLevel {
  JUNIOR_SECONDARY // Legacy records remain readable; new Indian classes use MIDDLE/SECONDARY.
  PRE_PRIMARY
  PRIMARY
  MIDDLE
  SECONDARY
  SENIOR_SECONDARY
}

enum AcademicCalendar {
  TWO_TERM
  THREE_TERM
  TWO_SEMESTER
  CONTINUOUS
}

// ===================================
// USER MANAGEMENT
// ===================================

model User {
  tokenVersion Int     @default(0)
  id           String  @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  middleName   String?
  phone        String?
  avatar       String?

  role        UserRole
  permissions Json? // Additional granular permissions

  isActive           Boolean @default(true)
  emailVerified      Boolean @default(false)
  phoneVerified      Boolean @default(false)
  mustChangePassword Boolean @default(false)

  // MFA
  mfaEnabled     Boolean  @default(false)
  mfaSecret      String?
  mfaBackupCodes String[] @default([])

  lastLoginAt DateTime?
  lastLoginIP String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAuditLogs AuditLog[]          @relation("CreatedBy")
  chatMemberships  ChatChannelMember[]
  chatMessages     ChatMessage[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([role])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_OWNER
  PRINCIPAL
  DEPUTY_PRINCIPAL
  SCHOOL_ADMIN
  ACCOUNTANT
  TEACHER
  CLASS_TEACHER
  EXAM_OFFICER
  LIBRARIAN
  TRANSPORT_OFFICER
  PARENT
  STUDENT
  RECEPTIONIST
  AUDITOR
}

// ===================================
// STUDENT MANAGEMENT
// ===================================

model Student {
  @@unique([id, tenantId])
  preschoolDays         PreschoolDayRecord[]
  developmentNotes      DevelopmentObservation[]
  cameraConsents        ClassroomCameraConsent[]
  transportAlerts       TransportAlert[]
  absenceRequests       AbsenceRequest[]
  portfolioEntries      PortfolioEntry[]
  quizAttempts          QuizAttempt[]
  travelAssignments     TravelAssignment[]
  tripPassengers        TripPassenger[]
  certificates          IssuedCertificate[]
  admissionApplications AdmissionRecord[]
  userId                String?                @unique
  submissions           AssignmentSubmission[]
  id                    String                 @id @default(uuid())
  tenantId              String
  admissionNumber       String

  // Personal Information
  firstName       String
  lastName        String
  middleName      String?
  dateOfBirth     DateTime
  gender          Gender
  aadhaarLast4    String?
  apaarId         String?
  penNumber       String?
  birthCertNumber String?

  // Contact
  email    String?
  phone    String?
  address  String?
  district String?
  state    String?
  pincode  String?

  // Medical
  bloodGroup        String?
  allergies         String?
  medicalConditions String?

  // Academic
  currentClassId  String?
  currentStreamId String?

  // Photos and Documents
  photo     String?
  documents Json? // Array of document URLs

  // Status
  status         StudentStatus @default(ACTIVE)
  admissionDate  DateTime
  graduationDate DateTime?

  // Notes
  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentClass  Class?  @relation("CurrentClass", fields: [currentClassId], references: [id])
  currentStream Stream? @relation("CurrentStream", fields: [currentStreamId], references: [id])

  guardianLinks     GuardianStudentLink[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  invoices          Invoice[]
  grades            Grade[]
  reportCards       ReportCard[]
  activityFeeds     ActivityFeed[]         @relation("StudentActivities")
  behaviorRecords   BehaviorRecord[]       @relation("StudentBehavior")
  bookings          ParentTeacherBooking[] @relation("StudentBookings")

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([admissionNumber])
  @@index([status])
  @@index([currentClassId])
  @@map("students")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  SUSPENDED
  DECEASED
}

model Guardian {
  @@unique([id, tenantId])
  cameraConsents ClassroomCameraConsent[]
  preschoolPickups PreschoolDayRecord[]
  id       String @id @default(uuid())
  tenantId String

  // Personal Information
  firstName    String
  lastName     String
  middleName   String?
  aadhaarLast4 String?

  // Contact
  email          String?
  phone          String
  alternatePhone String?
  address        String?

  // Professional
  occupation String?
  employer   String?

  // Emergency Contact
  isEmergencyContact Boolean @default(true)

  // Portal Access
  userId String? // Link to User account for portal access

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentLinks GuardianStudentLink[]
  bookings     ParentTeacherBooking[] @relation("GuardianBookings")

  @@index([tenantId])
  @@index([phone])
  @@index([email])
  @@map("guardians")
}

model GuardianStudentLink {
  id             String               @id @default(uuid())
  guardianId     String
  studentId      String
  relationship   GuardianRelationship
  isPrimary      Boolean              @default(false)
  canPickup      Boolean              @default(true)
  receiveUpdates Boolean              @default(true)

  createdAt DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([guardianId])
  @@index([studentId])
  @@map("guardian_student_links")
}

enum GuardianRelationship {
  MOTHER
  FATHER
  GUARDIAN
  GRANDPARENT
  SIBLING
  AUNT
  UNCLE
  OTHER
}

// ===================================
// STAFF MANAGEMENT
// ===================================

model Staff {
  @@unique([id, tenantId])
  preschoolAssignments PreschoolStaffAssignment[]
  id          String  @id @default(uuid())
  tenantId    String
  staffNumber String
  userId      String? // Link to User account

  // Personal Information
  firstName    String
  lastName     String
  middleName   String?
  dateOfBirth  DateTime?
  gender       Gender
  aadhaarLast4 String?
  panNumber    String?

  // Contact
  email          String
  phone          String
  alternatePhone String?
  address        String?

  // Employment
  department      StaffDepartment
  position        String
  employmentType  EmploymentType
  hireDate        DateTime
  terminationDate DateTime?

  // Academic (for teachers)
  isTeacher Boolean @default(false)
  subjects  Json? // Array of subject IDs they can teach

  // Status
  status StaffStatus @default(ACTIVE)

  // Documents
  photo     String?
  documents Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]
  staffAttendance  StaffAttendance[]

  @@unique([tenantId, staffNumber])
  @@index([tenantId])
  @@index([staffNumber])
  @@index([status])
  @@map("staff")
}

enum StaffDepartment {
  ADMINISTRATION
  TEACHING
  FINANCE
  LIBRARY
  TRANSPORT
  MAINTENANCE
  SECURITY
  IT
  OTHER
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PART_TIME
  TEMPORARY
  INTERN
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RETIRED
}

model StaffAttendance {
  markedBy String?
  remarks  String?
  id       String           @id @default(uuid())
  tenantId String
  staffId  String
  date     DateTime         @db.Date
  status   AttendanceStatus
  timeIn   DateTime?
  timeOut  DateTime?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([tenantId, staffId, date])
  @@index([tenantId])
  @@index([staffId])
  @@index([date])
  @@map("staff_attendance")
}

// ===================================
// ACADEMIC STRUCTURE
// ===================================

model AcademicYear {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms  Term[]

  @@index([tenantId])
  @@index([isCurrent])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String
  termNumber     Int
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]
  invoices      Invoice[]
  examinations  Examination[]
  reportCards   ReportCard[]

  @@index([tenantId])
  @@index([academicYearId])
  @@index([isCurrent])
  @@map("terms")
}

model Class {
  @@unique([id, tenantId])
  preschoolAssignments PreschoolStaffAssignment[]
  preschoolContent PreschoolContent[]
  classroomCameras ClassroomCamera[]
  assignments       Assignment[]
  examinations      Examination[]
  reportCards       ReportCard[]
  attendanceRecords AttendanceRecord[]
  id                String             @id @default(uuid())
  tenantId          String
  schoolId          String
  name              String
  level             String // e.g., "Class 1", "Class 10"
  educationLevel    EducationLevel
  preschoolStage    PreschoolStage?
  sortOrder         Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  streams          Stream[]
  currentStudents  Student[]        @relation("CurrentClass")
  enrollments      Enrollment[]
  feeStructures    FeeStructure[]
  timetableEntries TimetableEntry[]

  @@index([tenantId])
  @@index([schoolId])
  @@map("classes")
}

model Stream {
  examinations      Examination[]
  reportCards       ReportCard[]
  attendanceRecords AttendanceRecord[]
  id                String             @id @default(uuid())
  tenantId          String
  schoolId          String
  classId           String
  name              String // e.g., "A", "B", "East"
  capacity          Int                @default(40)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class            Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  currentStudents  Student[]        @relation("CurrentStream")
  enrollments      Enrollment[]
  timetableEntries TimetableEntry[]

  @@index([tenantId])
  @@index([classId])
  @@map("streams")
}

model Subject {
  assignments         Assignment[]
  examinationSubjects ExaminationSubject[]
  id                  String               @id @default(uuid())
  tenantId            String
  name                String
  code                String
  educationLevel      EducationLevel
  isCore              Boolean              @default(false)
  sortOrder           Int                  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades           Grade[]
  timetableEntries TimetableEntry[]

  @@index([tenantId])
  @@index([educationLevel])
  @@map("subjects")
}

model Enrollment {
  id             String   @id @default(uuid())
  tenantId       String
  studentId      String
  classId        String
  streamId       String?
  academicYearId String
  termId         String?
  enrollmentDate DateTime

  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  stream  Stream? @relation(fields: [streamId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@index([classId])
  @@map("enrollments")
}

// ===================================
// ATTENDANCE
// ===================================

model AttendanceRecord {
  classId     String?
  streamId    String?
  remarks     String?
  arrivalTime DateTime?
  class       Class?           @relation(fields: [classId], references: [id])
  stream      Stream?          @relation(fields: [streamId], references: [id])
  id          String           @id @default(uuid())
  tenantId    String
  studentId   String
  date        DateTime         @db.Date
  status      AttendanceStatus
  period      Int              @default(1) // For period-wise attendance
  markedBy    String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, date, period])
  @@index([tenantId])
  @@index([studentId])
  @@index([date])
  @@map("attendance_records")
}

enum AttendanceStatus {
  ON_LEAVE
  SICK_LEAVE
  OFFICIAL_DUTY
  PRESENT
  ABSENT
  LATE
  EXCUSED
  SICK
  HALF_DAY
}

// ===================================
// EXAMINATIONS & GRADING
// ===================================

model Examination {
  description     String?
  classId         String?
  streamId        String?
  examinationType String               @default("SUMMATIVE")
  gradingSystem   String               @default("PERCENTAGE")
  createdBy       String?
  class           Class?               @relation(fields: [classId], references: [id])
  stream          Stream?              @relation(fields: [streamId], references: [id])
  subjects        ExaminationSubject[]
  id              String               @id @default(uuid())
  tenantId        String
  termId          String
  name            String
  examType        ExamType             @default(ENDTERM)
  startDate       DateTime?
  endDate         DateTime?
  isPublished     Boolean              @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term   Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  grades Grade[]

  @@index([tenantId])
  @@index([termId])
  @@map("examinations")
}

enum ExamType {
  OPENER
  MIDTERM
  ENDTERM
  MOCK
  NATIONAL
  CAT
  ASSIGNMENT
}

model Grade {
  score           Int     @default(0)
  totalMarks      Int     @default(100)
  percentage      Float   @default(0)
  letterGrade     String  @default("E")
  competencyLevel String?
  enteredBy       String?
  id              String  @id @default(uuid())
  tenantId        String
  examinationId   String
  studentId       String
  subjectId       String
  marks           Float?
  grade           String?
  remarks         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examination Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examinationId, studentId, subjectId])
  @@index([tenantId])
  @@index([studentId])
  @@index([examinationId])
  @@map("grades")
}

model ReportCard {
  gradeSnapshot        Json?
  classId              String?
  streamId             String?
  totalScore           Float            @default(0)
  averagePercentage    Float            @default(0)
  classTeacherComments String?
  principalComments    String?
  generatedBy          String?
  approvedBy           String?
  approvedAt           DateTime?
  class                Class?           @relation(fields: [classId], references: [id])
  stream               Stream?          @relation(fields: [streamId], references: [id])
  id                   String           @id @default(uuid())
  tenantId             String
  studentId            String
  termId               String
  overallGrade         String?
  overallPercentage    Float?
  position             Int?
  totalStudents        Int?
  teacherComment       String?
  principalComment     String?
  status               ReportCardStatus @default(DRAFT)

  generatedAt DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, termId])
  @@index([tenantId])
  @@index([studentId])
  @@index([termId])
  @@map("report_cards")
}

enum ReportCardStatus {
  APPROVED
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
}

// Continue in next message due to length...

// ===================================
// FEE MANAGEMENT
// ===================================

model FeeStructure {
  invoices    Invoice[]
  id          String    @id @default(uuid())
  tenantId    String
  termId      String
  classId     String?
  name        String
  description String?
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term     Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  class    Class?    @relation(fields: [classId], references: [id])
  feeItems FeeItem[]

  @@index([tenantId])
  @@index([termId])
  @@index([classId])
  @@map("fee_structures")
}

model FeeItem {
  id             String      @id @default(uuid())
  feeStructureId String
  name           String
  description    String?
  amount         Int // In minor units (paise)
  feeCategory    FeeCategory
  isOptional     Boolean     @default(false)
  sortOrder      Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
  @@map("fee_items")
}

enum FeeCategory {
  TUITION
  ADMISSION
  EXAMINATION
  TRANSPORT
  BOARDING
  MEALS
  LIBRARY
  SPORTS
  ACTIVITY
  UNIFORM
  BOOKS
  LABORATORY
  OTHER
}

model Invoice {
  feeStructureId             String?
  feeStructure               FeeStructure?               @relation(fields: [feeStructureId], references: [id])
  paymentGatewayTransactions PaymentGatewayTransaction[]
  id                         String                      @id @default(uuid())
  tenantId          String
  invoiceNumber     String
  studentId         String
  termId            String
  totalAmount       Int // In minor units
  paidAmount        Int                @default(0)
  balanceAmount     Int // Calculated: totalAmount - paidAmount
  status            InvoiceStatus      @default(PENDING)
  dueDate           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term          @relation(fields: [termId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]
  payments     Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([studentId])
  @@index([termId])
  @@index([status])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id          String      @id @default(uuid())
  invoiceId   String
  description String
  amount      Int // In minor units
  feeCategory FeeCategory

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  allocatedTransactions PaymentGatewayTransaction[] @relation("AllocatedPayment")
  id                    String                      @id @default(uuid())
  tenantId              String
  invoiceId             String
  amount                Int // In minor units (paise)
  paymentMethod         PaymentMethod
  reference             String // UTR, Razorpay payment ID, cheque ref, etc.
  status                PaymentStatus               @default(PENDING)
  paymentDate           DateTime                    @default(now())

  // Payment Gateway specific (Razorpay / UPI)
  gatewayTransactionId String?

  // Receipt
  receiptNumber   String?
  receiptIssued   Boolean   @default(false)
  receiptIssuedAt DateTime?

  notes       String?
  processedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice            Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  gatewayTransaction PaymentGatewayTransaction? @relation(fields: [gatewayTransactionId], references: [id])

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([status])
  @@index([paymentDate])
  @@map("payments")
}

enum PaymentMethod {
  MPESA // Preserve historical payment ledgers from earlier deployments.
  RAZORPAY
  UPI
  NET_BANKING
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

// ===================================
// RAZORPAY / UPI PAYMENT GATEWAY
// ===================================

model PaymentGatewayTransaction {
  payment              Payment?  @relation("AllocatedPayment", fields: [paymentId], references: [id])
  invoiceId            String?
  paymentId            String?
  initiatedBy          String?
  responseCode         String?
  responseDescription  String?
  callbackReceived     Boolean   @default(false)
  callbackReceivedAt   DateTime?
  reconciliationStatus String    @default("PENDING")
  metadata             Json?
  invoice              Invoice?  @relation(fields: [invoiceId], references: [id])
  id                   String    @id @default(uuid())
  tenantId             String

  // Gateway Provider & Request Details
  gateway          PaymentGatewayProvider @default(RAZORPAY)
  gatewayOrderId   String?                @unique
  gatewayPaymentId String?                @unique

  // Transaction Details
  transactionType  PaymentGatewayTxType
  amount           Int // In minor units (paise)
  currency         String               @default("INR")
  phoneNumber      String?
  upiVpa           String?
  accountReference String // Student admission number or invoice number
  transactionDesc  String?

  // Response Details
  utrNumber       String?   @unique
  receiptNumber   String?   @unique
  transactionDate DateTime?
  resultCode      Int?
  resultDesc      String?

  // Status
  status PaymentGatewayStatus @default(INITIATED)

  // Metadata
  requestPayload  Json?
  callbackPayload Json?

  // Reconciliation
  isReconciled Boolean   @default(false)
  reconciledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([utrNumber])
  @@index([receiptNumber])
  @@index([status])
  @@index([isReconciled])
  @@map("payment_gateway_transactions")
}

enum PaymentGatewayProvider {
  RAZORPAY
  UPI
  MANUAL
}

enum PaymentGatewayTxType {
  MANUAL
  RAZORPAY_ORDER
  UPI_INTENT
  UPI_QR
  NET_BANKING
  CARD
}

enum PaymentGatewayStatus {
  COMPLETED
  INITIATED
  PENDING
  AUTHORIZED
  CAPTURED
  SUCCESS
  FAILED
  TIMEOUT
  CANCELLED
  REFUNDED
  RECONCILED
}

