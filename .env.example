# Database
DATABASE_URL="postgresql://krypton:krypton@localhost:5432/krypton_dev"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT Authentication
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="604800"

# Account Lockout Configuration
# Maximum failed login attempts before lockout
AUTH_MAX_ATTEMPTS="5"
# Lockout duration in minutes
AUTH_LOCKOUT_MINUTES="15"
# Time window in minutes for counting failed attempts
AUTH_ATTEMPT_WINDOW_MINUTES="15"

# Application
NODE_ENV="development"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
API_PORT="3001"
WEB_PORT="3000"

# M-Pesa Configuration (Sandbox)
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="your-sandbox-consumer-key"
MPESA_CONSUMER_SECRET="your-sandbox-consumer-secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="your-sandbox-passkey"
MPESA_CALLBACK_URL="https://your-domain.com/api/v1/mpesa/callback"
MPESA_TIMEOUT_URL="https://your-domain.com/api/v1/mpesa/timeout"
MPESA_RESULT_URL="https://your-domain.com/api/v1/mpesa/result"

# Email Configuration
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@kryptonschool.com"
EMAIL_FROM_NAME="Krypton School ERP"

# SMS Configuration (Africa's Talking)
SMS_PROVIDER="africastalking"
SMS_API_KEY="your-sandbox-api-key"
SMS_USERNAME="sandbox"
SMS_FROM="KRYPTON"

# WhatsApp Configuration (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# WhatsApp Scheduler
WHATSAPP_SCHEDULER_ENABLED="true"

# S3-Compatible Object Storage (MinIO for dev)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="krypton-dev"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
S3_USE_SSL="false"

# Monitoring & Logging (Optional)
SENTRY_DSN=""
LOG_LEVEL="debug"

# Rate Limiting
RATE_LIMIT_WINDOW="15m"
RATE_LIMIT_MAX_REQUESTS="100"

# Session
SESSION_SECRET="change-this-to-a-secure-random-string"

# Encryption
# IMPORTANT: Generate secure keys for production using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# ENCRYPTION_MASTER_KEY: Used to derive encryption keys (minimum 32 characters)
# ENCRYPTION_SALT: Used for key derivation (64 hex characters = 32 bytes)
ENCRYPTION_MASTER_KEY="change-this-to-a-secure-random-string-at-least-32-chars-long"
ENCRYPTION_SALT="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Legacy encryption key (DEPRECATED - will be removed in favor of ENCRYPTION_MASTER_KEY)
ENCRYPTION_KEY="change-this-to-a-32-byte-hex-string"

# Multi-tenant
DEFAULT_TENANT_PLAN="starter"
TENANT_SUBDOMAIN_SUFFIX=".kryptonschool.local"

# Feature Flags
FEATURE_TRANSPORT="true"
FEATURE_LIBRARY="true"
FEATURE_INVENTORY="true"
FEATURE_HR="true"
FEATURE_AI_INSIGHTS="false"

# AI teaching tools (Free AI - No paid API keys required)
AI_TEACHER_ENABLED="true"
AI_PROVIDER="FreeAI" # Options: FreeAI, Gemini, Groq, Ollama, Pollinations
# Optional free API keys (Leave empty to use 100% free built-in & Pollinations zero-key provider)
GEMINI_API_KEY="" # Free tier from Google AI Studio (15 requests/min free, no credit card required)
GROQ_API_KEY=""   # Free tier from Groq Cloud
OLLAMA_BASE_URL="" # Local free Ollama (e.g. http://localhost:11434)
AI_MODEL=""       # Optional model override (e.g. gemini-1.5-flash, llama-3.3-70b-versatile)
