# Database
DATABASE_URL="postgresql://krypton:krypton@localhost:5432/krypton_dev"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT Authentication
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-this-to-another-secure-random-string"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="604800"

# Account Lockout Configuration
# Maximum failed login attempts before lockout
AUTH_MAX_ATTEMPTS="5"
# Lockout duration in minutes
AUTH_LOCKOUT_MINUTES="15"
# Time window in minutes for counting failed attempts
AUTH_ATTEMPT_WINDOW_MINUTES="15"

# Application
NODE_ENV="development"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
API_PORT="3001"
WEB_PORT="3000"

# Payment Gateway Configuration (Razorpay & NPCI UPI)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
PAYMENT_GATEWAY_CALLBACK_URL="https://your-domain.com/api/v1/payments-gateway/callback"
SCHOOL_UPI_VPA=""
SCHOOL_MERCHANT_NAME=""

# Government Compliance (UDISE+ / State Board)
UDISE_API_BASE_URL="https://api.udiseplus.gov.in/v1"
UDISE_API_KEY="your_udise_api_key_here"
UDISE_CLIENT_ID="your_udise_client_id_here"

# Email Configuration
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@kryptonschool.edu.in"
EMAIL_FROM_NAME="Krypton School ERP"

# SMS Configuration
SMS_PROVIDER="custom"
SMS_API_KEY="your-sms-api-key"
SMS_SENDER_ID="KRYPTN"

# Live WhatsApp Business Gateway Configuration
# Options: META_CLOUD_API | GUPSHUP | TWILIO | WHATSAPP_WEB (Zero-Cost Play-School Mode)
WHATSAPP_PROVIDER="WHATSAPP_WEB"

# 1. Meta WhatsApp Cloud API (Official Graph API - Recommended for Real Schools)
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_WABA_ID=""
META_WHATSAPP_API_VERSION="v19.0"
META_WHATSAPP_VERIFY_TOKEN="krypton_whatsapp_verify_token"

# 2. Gupshup Enterprise WhatsApp API (Popular Indian School BSP)
GUPSHUP_API_KEY=""
GUPSHUP_APP_NAME=""
GUPSHUP_SOURCE_NUMBER=""

# 3. Twilio Programmable WhatsApp API
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# WhatsApp Scheduler
WHATSAPP_SCHEDULER_ENABLED="true"

# S3-Compatible Object Storage (MinIO for dev)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="krypton-dev"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
S3_USE_SSL="false"

# Monitoring & Logging (Optional)
SENTRY_DSN=""
LOG_LEVEL="debug"

# Rate Limiting
RATE_LIMIT_WINDOW="15m"
RATE_LIMIT_MAX_REQUESTS="100"

# Session
SESSION_SECRET="change-this-to-a-secure-random-string"

# Encryption
# IMPORTANT: Generate secure keys for production using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# ENCRYPTION_MASTER_KEY: Used to derive encryption keys (minimum 32 characters)
# ENCRYPTION_SALT: Used for key derivation (64 hex characters = 32 bytes)
ENCRYPTION_MASTER_KEY="change-this-to-a-secure-random-string-at-least-32-chars-long"
ENCRYPTION_SALT="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Legacy encryption key (DEPRECATED - will be removed in favor of ENCRYPTION_MASTER_KEY)
ENCRYPTION_KEY="change-this-to-a-32-byte-hex-string"

# Multi-tenant
DEFAULT_TENANT_PLAN="starter"
TENANT_SUBDOMAIN_SUFFIX=".kryptonschool.local"

# Backup Configuration
BACKUP_ENABLED="true"
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="14"
BACKUP_SCHEDULE="0 2 * * *"  # Cron format: Daily at 2 AM

# Feature Flags
FEATURE_TRANSPORT="true"
FEATURE_LIBRARY="true"
FEATURE_INVENTORY="true"
FEATURE_HR="true"
FEATURE_AI_INSIGHTS="false"

# AI teaching tools & INKY Preschool AI
AI_TEACHER_ENABLED="true"
AI_PROVIDER="" # Leave empty to auto-detect from keys (Gemini -> Groq -> OpenAI -> Ollama), or set: FreeAI, Gemini, Groq, OpenAI, Ollama, Pollinations
GEMINI_API_KEY="" # Free tier from Google AI Studio (https://aistudio.google.com/apikey)
GROQ_API_KEY=""   # Free tier from Groq Cloud (https://console.groq.com/keys)
OPENAI_API_KEY="" # Optional OpenAI API key
OPENAI_MODEL=""   # Optional OpenAI model override (default: gpt-4.1-mini)
OLLAMA_BASE_URL="" # Local free Ollama (e.g. http://localhost:11434)
AI_MODEL=""       # Optional model override (e.g. gemini-flash-latest, llama-3.3-70b-versatile)
# Optional classroom streaming gateway (all three values must be set together).
# Keep cameras disabled until a gateway has been connected and tested.
CCTV_GATEWAY_URL=
CCTV_GATEWAY_KEY=
CCTV_PLAYBACK_ORIGINS=

# Built-in school calls: coturn REST shared-secret credentials (never NEXT_PUBLIC).
# Production calls require a configured relay; shared boards work independently.
WEBRTC_STUN_URLS=
WEBRTC_TURN_URLS=
WEBRTC_TURN_SECRET=
