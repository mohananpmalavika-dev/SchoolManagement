# Docker Compose production configuration. Copy to .env.production and supply real values.
# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep encryption keys and salt stable and back them up securely; changing them loses access to encrypted records.
PUBLIC_ORIGIN=https://school.your-domain.com
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_MASTER_KEY=
ENCRYPTION_SALT=
ENCRYPTION_KEY=

# Recovery email must be configured and delivery verified before enabling user onboarding.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=

# Payment Gateway (Razorpay & NPCI UPI)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_CALLBACK_URL=
UPI_VPA_DEFAULT=kryptonfees@icici

# Government Compliance (UDISE+ / State Board)
UDISE_API_BASE_URL=https://api.udiseplus.gov.in/v1
UDISE_API_KEY=
UDISE_CLIENT_ID=

SMS_API_KEY=
SMS_SENDER_ID=

# Backups are persisted in the backups volume. Optional off-site S3 storage:
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14
S3_ENDPOINT=
S3_BUCKET=krypton
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_SSL=true
S3_PUBLIC_URL=
# Optional preschool CCTV gateway. Gateway must enforce playback expiry.
CCTV_GATEWAY_URL=
CCTV_GATEWAY_KEY=
CCTV_PLAYBACK_ORIGINS=

# Preschool teaching drafts work with the labelled built-in template library.
# Select a provider and configure its key to use external generation.
AI_TEACHER_ENABLED=true
AI_PROVIDER=FreeAI
AI_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=
