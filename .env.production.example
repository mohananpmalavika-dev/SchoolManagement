# Docker Compose production configuration. Copy to .env.production and supply real values.
# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep encryption keys and salt stable and back them up securely; changing them loses access to encrypted records.
PUBLIC_ORIGIN=https://school.your-domain.com
PUBLIC_HOSTNAME=school.your-domain.com
TLS_CONTACT_EMAIL=operations@your-domain.com
TLS_VOLUME_NAME=krypton_tls_data
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_MASTER_KEY=
ENCRYPTION_SALT=
ENCRYPTION_KEY=

# Recovery email must be configured and delivery verified before enabling user onboarding.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=

# Payment Gateway (Razorpay & NPCI UPI)
# New school payments: configure School > Fees > School payment accounts.
# Environment Razorpay keys below are only for outstanding pre-deployment orders.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_CALLBACK_URL=
SCHOOL_UPI_VPA=
SCHOOL_MERCHANT_NAME=

# Government submissions use reviewed exports and official portals manually.
# There is no approved government API adapter; do not supply speculative API credentials.

SMS_API_KEY=
SMS_USERNAME=

# Live WhatsApp Business Gateway (META_CLOUD_API | GUPSHUP | TWILIO | WHATSAPP_WEB)
WHATSAPP_PROVIDER=WHATSAPP_WEB
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_API_VERSION=v19.0
META_WHATSAPP_VERIFY_TOKEN=
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Pre-create this external volume; keep the key in independent custody.
# See ops/RUNBOOK.md for volume ownership, secret files and recovery commands.
BACKUP_VOLUME_NAME=krypton_backups
BACKUP_KEY_SECRET_FILE=/etc/krypton/backup-key
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14
BACKUP_REQUIRE_OFFSITE=true
BACKUP_MAX_AGE_HOURS=30
RESTORE_MAX_AGE_HOURS=840
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
# Application media storage is configured separately from off-site backups.
S3_ENDPOINT=
S3_BUCKET=krypton
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_SSL=true
S3_PUBLIC_URL=

# One-time platform administrator; password is read from a secret file.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FIRST_NAME=
INITIAL_ADMIN_LAST_NAME=
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_PASSWORD_SECRET_FILE=/etc/krypton/initial-admin-password

# Isolated, pre-created EMPTY database URL stored in this secret file.
# Database name must end in _test, _qa or _rehearsal; never use the primary.
RESTORE_DATABASE_SECRET_FILE=/etc/krypton/restore-database-url
RESTORE_BACKUP_ID=
# Independently reviewed counts from the chosen snapshot, not a query of the restored target.
RESTORE_EXPECTED_TABLES=
RESTORE_EXPECTED_TENANTS=
RESTORE_EXPECTED_USERS=
# Optional preschool CCTV gateway. Gateway must enforce playback expiry.
CCTV_GATEWAY_URL=
CCTV_GATEWAY_KEY=
CCTV_PLAYBACK_ORIGINS=

# Preschool teaching drafts (INKY AI) fall back to the labelled built-in template library if no key is set.
# Configure GEMINI_API_KEY, GROQ_API_KEY, or OPENAI_API_KEY (leave AI_PROVIDER empty to auto-detect).
AI_TEACHER_ENABLED=true
AI_PROVIDER=
AI_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=

# Built-in school calls: coturn REST shared-secret credentials (never NEXT_PUBLIC).
# Production calls require a configured relay; shared boards work independently.
WEBRTC_STUN_URLS=
WEBRTC_TURN_URLS=
WEBRTC_TURN_SECRET=

# Optional background Web Push (all three API values must be configured together).
# Generate once with: node scripts/generate-web-push-keys.mjs
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
