# Copy to .env.live-verification.local (gitignored). Never put live credentials in this example.
# Read-only checks: no orders, messages, uploads, database writes, or restores are initiated.
LIVE_WEB_URL=
LIVE_API_BASE_URL=
LIVE_CCTV_GATEWAY_URL=
# School finance QA token from the deployed API. Never use a production user's session.
LIVE_QA_TOKEN=
# A valid QA account token from another test school/tenant for the negative media access check.
LIVE_FOREIGN_QA_TOKEN=
# Existing non-sensitive QA photo/document accessible to the first QA account.
LIVE_MEDIA_ID=
