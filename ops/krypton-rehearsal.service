[Unit]
Description=Krypton off-site restore rehearsal (requires reviewed snapshot and empty target)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/krypton
ExecStart=/usr/bin/docker compose --env-file .env.production -f docker-compose.production.yml --profile operations run --rm rehearsal
TimeoutStartSec=2h
UMask=0077
StandardOutput=journal
StandardError=journal
